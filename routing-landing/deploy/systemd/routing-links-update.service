[Unit]
Description=Rebuild the connection landing page (INCY links, pay form script)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nginx
Group=nginx
ExecStart=/opt/routing-links/update.sh
Environment=ROUTING_APP_DIR=/opt/routing-links ROUTING_DATA_DIR=/var/lib/routing-links
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/routing-links
TimeoutStartSec=180
