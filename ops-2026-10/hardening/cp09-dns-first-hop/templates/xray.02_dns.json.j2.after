{
  "dns": {
    "servers": [
      {
        "address": "https+local://{{hconfigs['dns_server'] or "1.1.1.1" }}/dns-query",
        "timeoutMs": 2000
      },
      {
        "address": "https+local://8.8.8.8/dns-query",
        "timeoutMs": 2000
      },
      {
        "address": "https+local://9.9.9.9/dns-query",
        "timeoutMs": 2000
      }
    ],
    "queryStrategy": "UseIPv4",
    "tag": "DNS-Internal"
  }
}