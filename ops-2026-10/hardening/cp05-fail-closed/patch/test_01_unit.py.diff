+    def test_a_config_from_before_the_fix_is_brought_to_fail_closed_by_one_transform(self):
+        """what the first `multiloc_ctl.py apply` after the update sees: the LIVE config has balancers (countries and AUTO) without fallbackTag. transform() must
+        fix exactly that (nothing else), the fixed config must pass the invariants, and a second pass must change nothing."""
+        p = plan()
+        fixed = mr.transform(self.base, p)
+        old_live = copy.deepcopy(fixed)
+        for b in old_live["routing"]["balancers"]:
+            b.pop("fallbackTag", None)
+        self.assertTrue(mr.check_invariants(old_live))                                    # the old shape is now reported as a problem
+        again = mr.transform(old_live, p)
+        self.assertEqual(again, fixed)
+        self.assertEqual(mr.check_invariants(again), [])
+        self.assertEqual(mr.transform(again, p), again)                                   # idempotent: no restart for an already fixed router
+        changed = [b["tag"] for b, o in zip(again["routing"]["balancers"], old_live["routing"]["balancers"]) if b != o]
+        self.assertEqual(changed, ["upstream-balancer", "balancer-s1", "balancer-s2"])    # only the fallbackTag of the balancers differs
+
+    def test_auto_fails_closed_too_and_the_layer_still_strips_cleanly(self):
+        out = mr.transform(self.base, plan())
+        g = next(b for b in out["routing"]["balancers"] if b["tag"] == "upstream-balancer")
+        self.assertEqual(g["fallbackTag"], "block")
+        self.assertEqual(g["selector"], next(b for b in self.base["routing"]["balancers"] if b["tag"] == "upstream-balancer")["selector"])     # membership untouched
+        self.assertEqual(mr.strip(out), self.base)                                         # removing the layer removes the AUTO fallback it added
+        self.assertEqual(mr.transform(out, {"slots": {}}), self.base)                      # feature off -> exact legacy config
+        # the RU-direct rules still precede every balancer rule: AUTO closing cannot touch Russian destinations
+        r = rules_of(out)
+        last_ru = max(i for i, x in enumerate(r) if x.get("outboundTag") == "direct-ru")
+        first_bal = min(i for i, x in enumerate(r) if x.get("balancerTag") == "upstream-balancer" and x.get("network") == "tcp,udp")
+        self.assertLess(last_ru, first_bal)
+
