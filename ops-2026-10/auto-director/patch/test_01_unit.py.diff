+    def test_director_invariants_catch_regressions(self):
+        out = mr.transform(self.base, self.dplan())
+
+        def broken(fn):
+            c = copy.deepcopy(out)
+            fn(c)
+            return mr.check_invariants(c)
+        self.assertTrue(any("fallbackTag must be 'block'" in p for p in broken(lambda c: next(b for b in c["routing"]["balancers"] if b["tag"] == "auto-director").pop("fallbackTag"))))
+        self.assertTrue(any("needs the API entrance" in p for p in broken(lambda c: c.pop("api"))))
+        self.assertTrue(any("unix socket" in p for p in broken(lambda c: next(i for i in c["inbounds"] if i["tag"] == "api").update(listen="127.0.0.1", port=20899))))
+        self.assertTrue(any("not a loopback" in p for p in broken(lambda c: c["outbounds"].__setitem__(
+            next(i for i, o in enumerate(c["outbounds"]) if o["tag"] == "auto-via-s1"), {"tag": "auto-via-s1", "protocol": "freedom"}))))
+        self.assertTrue(any("no rule routes the inbound" in p for p in broken(lambda c: c["routing"]["rules"].pop(1))))
+        self.assertTrue(any("could loop" in p for p in broken(lambda c: c["routing"]["rules"].append(c["routing"]["rules"].pop(1)))))
+        self.assertTrue(any("catch-all must use auto-director" in p for p in broken(lambda c: c["routing"]["rules"][-1].update(balancerTag="upstream-balancer"))))
+        self.assertTrue(any("not covered by the observatory" in p for p in broken(lambda c: c["observatory"].update(subjectSelector=["upstream-4"]))))
+        self.assertTrue(any("no rule routes the API entrance" in p for p in broken(lambda c: c["routing"]["rules"].pop(0))))
