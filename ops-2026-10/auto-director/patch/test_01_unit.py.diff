+    def test_director_is_off_unless_the_plan_enables_it(self):
+        out = mr.transform(self.base, plan())
+        self.assertFalse([o for o in out["outbounds"] if o["tag"].startswith("auto-via-")])
+        self.assertNotIn("api", out)
+        self.assertNotIn("auto-director", [b["tag"] for b in out["routing"]["balancers"]])
+        self.assertEqual(rules_of(out)[-1].get("balancerTag"), "upstream-balancer")
+
+    def test_director_structure(self):
+        out = mr.transform(self.base, self.dplan())
+        r = rules_of(out)
+        # the API rule and the loopback passes are the FIRST rules: a looped connection is decided there and can never reach the catch-all again
+        self.assertEqual(r[0], {"type": "field", "inboundTag": ["api"], "outboundTag": "api"})
+        self.assertEqual(r[1], {"type": "field", "inboundTag": ["auto-in-s1"], "balancerTag": "balancer-s1"})
+        self.assertEqual(r[2], {"type": "field", "inboundTag": ["auto-in-s2"], "balancerTag": "balancer-s2"})
+        self.assertEqual(r[-1], {"type": "field", "network": "tcp,udp", "balancerTag": "auto-director"})
+        loops = {o["tag"]: o for o in out["outbounds"] if o["protocol"] == "loopback"}
+        self.assertEqual(sorted(loops), ["auto-via-s1", "auto-via-s2"])
+        self.assertEqual(loops["auto-via-s1"]["settings"], {"inboundTag": "auto-in-s1"})
+        d = next(b for b in out["routing"]["balancers"] if b["tag"] == "auto-director")
+        self.assertEqual((d["selector"], d["fallbackTag"], d["strategy"]["type"]), (["auto-via-s1", "auto-via-s2"], "block", "leastPing"))
+        self.assertEqual(out["api"], {"tag": "api", "services": ["RoutingService"]})
+        api_in = next(i for i in out["inbounds"] if i["tag"] == "api")
+        self.assertEqual(api_in["listen"], "/run/xray-router-api.sock,0600")                    # root-only unix socket, never a TCP port
+        self.assertNotIn("port", api_in)
+        self.assertTrue(set(["auto-via-s1", "auto-via-s2"]) <= set(out["observatory"]["subjectSelector"]))
+        # the plain global balancer is kept for the rules that still use it (proxy-DNS addresses): fail closed, untouched membership
+        g = next(b for b in out["routing"]["balancers"] if b["tag"] == "upstream-balancer")
+        self.assertEqual(g["fallbackTag"], "block")
+        self.assertEqual(mr.check_invariants(out), [])
+
+    def test_director_strip_is_exact_and_the_transform_is_idempotent(self):
+        out = mr.transform(self.base, self.dplan())
+        self.assertEqual(mr.strip(out), self.base)
+        self.assertEqual(mr.transform(out, self.dplan()), out)
+        # switching the director off brings back the layer WITHOUT it, and "feature off" brings back the legacy config
+        self.assertEqual(mr.transform(out, plan()), mr.transform(self.base, plan()))
+        self.assertEqual(mr.transform(out, {"slots": {}}), self.base)
