# lk: registration page of the trial access (static page + the one API call it needs). Custom, NOT generated by Hiddify (no .j2 twin), survives install.sh / apply_configs.
# A separate name-based server on the same unix socket as Hiddify's server `_` (conf.d/xray-base.conf); HAProxy routes unknown hosts to this socket, nginx picks this block by Host.
# !! FILE NAME MATTERS (same as zz-routing-links.conf): it has to sort AFTER xray-base.conf so that Hiddify's block stays the default one.
# Remove: delete this file, `nginx -t`, `systemctl reload hiddify-nginx` (deploy: lk/install_lk.sh --remove).

map $proxy_protocol_server_port $lk_plain {
    default 0;
    80      1;
}
# a second limit in front of the panel's own one (2 per hour per address, kept in the memory of each panel process): 6 requests a minute, a burst of 3
limit_req_zone $binary_remote_addr zone=lk_trial:1m rate=6r/m;

server {
    listen unix:/opt/hiddify-manager/nginx/run/h2.sock proxy_protocol;
    http2 on;
    set_real_ip_from unix:;
    real_ip_header proxy_protocol;
    server_name @@HOST@@;

    root @@ROOT@@;
    access_log off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;

    # ACME http-01 (the panel renews the certificate of this domain through the webroot it shares with acme.sh). Plain HTTP must stay reachable here.
    location ^~ /.well-known/acme-challenge/ {
        root /opt/hiddify-manager/acme.sh/www;
        default_type text/plain;
    }

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = / {
        if ($lk_plain) { return 301 https://$host$request_uri; }
        try_files /index.html =404;
    }

    # the cover pictures of the front page (public, cached a day)
    location ~ ^/(?:cw|ct)\.webp$ {
        if ($lk_plain) { return 404; }
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # the working part: handed out only with the gate number (the front page asks for it after the example is solved; nothing about the service is in the front page)
    location = /app.html {
        if ($lk_plain) { return 404; }
        if ($arg_k != "@@GATE@@") { return 404; }
        try_files /app.html =404;
    }
    location = /app.js {
        if ($lk_plain) { return 404; }
        if ($arg_k != "@@GATE@@") { return 404; }
        default_type application/javascript;
        try_files /app.js =404;
    }

    # the page's only call: the phone goes to the panel's trial endpoint, the answer comes back unchanged. The client's real address is the one the panel limits by.
    location = /api/trial {
        if ($lk_plain) { return 404; }
        if ($request_method != POST) { return 405; }
        limit_req zone=lk_trial burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 2k;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:9000/@@PATH@@/api/v2/trial/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Content-Type "application/json";
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
