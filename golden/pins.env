# Versions the golden node runs that the base installer does NOT pin (the installer takes the newest it knows). Checked by sha256 before anything is installed.
XRAY_VERSION=v26.7.28
XRAY_ZIP_URL=https://github.com/XTLS/Xray-core/releases/download/v26.7.28/Xray-linux-64.zip
XRAY_ZIP_SHA256=8195d909f1109b8f3d99eefe401a3c451d7bf4af71f24d3815420f77e5dd2a40
XRAY_BIN_SHA256=64d46afb80adea1bf97a0d467e83f4a9ac1ebd0995891e84bca3f1a1d1affb1d
XRAY_TARGETS="/opt/hiddify-manager/xray/bin/xray"   # /usr/bin/xray is a symlink to it: the asset lookup of xray follows the real path, never replace the symlink by a copy
# geo data the node runs (Loyalsoldier/v2ray-rules-dat, release 202610152206 of 2026-10-15); read by the router and the first hop from the xray directory
GEO_RELEASE=202610152206
GEOIP_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/202610152206/geoip.dat
GEOIP_SHA256=1931cec183daad70aa84c1ff7559d316c94cd3e67ddba4b8fddde125f10068bc
GEOSITE_URL=https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/202610152206/geosite.dat
GEOSITE_SHA256=9d951dbf2fcbabd04cd18051a6679eaa1da12566ddf5aa613e53eaee88ae7dc7
GEO_DIR=/opt/hiddify-manager/xray/bin
