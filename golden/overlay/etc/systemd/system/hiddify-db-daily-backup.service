[Unit]
Description=VPN Ru Node daily database-only backup (dump, age-encrypt, Selectel db-daily/)
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/vpn-db-backup/db-daily-backup.sh
WorkingDirectory=/opt/vpn-db-backup
User=root
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
Nice=10
