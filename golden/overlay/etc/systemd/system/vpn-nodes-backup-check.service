[Unit]
Description=VPN Ru Node: check that the exit-node backups in the cloud are fresh (sets markers for vpn-watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/vpn-db-backup/nodes-backup-check.sh
User=root
StateDirectory=vpn-backup
StateDirectoryMode=0700
TimeoutStartSec=300
Nice=10
